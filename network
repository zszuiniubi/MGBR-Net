def MBEM(output):
    z = output.cpu().detach().numpy()
    z = np.where(z > 0.3, 1.0, 0.0)  # covert segmentation result
    z = torch.tensor(z)
    kernel = np.ones((3, 3), np.uint8)  # kernal matrix
    maskd = np.zeros_like(output.cpu().detach().numpy())  # result array
    maske = np.zeros_like(output.cpu().detach().numpy())  # result array
    for i in range(output.shape[0]):
        y = z[i].permute(1, 2, 0)
        erosion = y.cpu().detach().numpy()
        dilate = y.cpu().detach().numpy()
        dilate = np.array(dilate, dtype='uint8')
        erosion = np.array(erosion, dtype='uint8')
        erosion = cv.erode(erosion, kernel, 5)
        dilate = cv.dilate(dilate, kernel, 5)
        mask1 = torch.tensor(dilate - erosion).unsqueeze(-1).permute(2, 0, 1)
        mask2 = torch.tensor(erosion).unsqueeze(-1).permute(2, 0, 1)
        maskd[i] = mask1
        maske[i] = mask2
    maskd = torch.tensor(maskd)
    maskd = maskd.cuda()
    maske = torch.tensor(maske)
    maske = maske.cuda()
    return maskd, maske  # maskd 边缘 maske 内部 1,1,88,88


def to_3d(x):
    return rearrange(x, 'b c h w -> b (h w) c')


def to_4d(x, h, w):
    return rearrange(x, 'b (h w) c -> b c h w', h=h, w=w)


class ChannelGate(nn.Module):
    def __init__(self, gate_channels, reduction_ratio=16):
        super(ChannelGate, self).__init__()
        self.gate_channels = gate_channels
        self.mlp = nn.Sequential(
            nn.Flatten(),
            nn.Linear(gate_channels, gate_channels // reduction_ratio),
            nn.ReLU(),
            nn.Linear(gate_channels // reduction_ratio, gate_channels)
        )

    def forward(self, x):
        avg_out = self.mlp(F.avg_pool2d(x, (x.size(2), x.size(3)), stride=(x.size(2), x.size(3))))
        max_out = self.mlp(F.max_pool2d(x, (x.size(2), x.size(3)), stride=(x.size(2), x.size(3))))
        channel_att_sum = avg_out + max_out

        scale = torch.sigmoid(channel_att_sum).unsqueeze(2).unsqueeze(3).expand_as(x)
        return x * scale


class SpatialGate(nn.Module):
    def __init__(self):
        super(SpatialGate, self).__init__()
        kernel_size = 7
        self.spatial = nn.Conv2d(2, 1, kernel_size, stride=1, padding=(kernel_size - 1) // 2)

    def forward(self, x):
        x_compress = torch.cat((torch.max(x, 1)[0].unsqueeze(1), torch.mean(x, 1).unsqueeze(1)), dim=1)
        x_out = self.spatial(x_compress)
        scale = torch.sigmoid(x_out)  # broadcasting
        return x * scale


class CBAM(nn.Module):
    def __init__(self, gate_channels, reduction_ratio=16):
        super(CBAM, self).__init__()
        self.ChannelGate = ChannelGate(gate_channels, reduction_ratio)
        self.SpatialGate = SpatialGate()

    def forward(self, x):
        x_out = self.ChannelGate(x)
        x_out1 = self.SpatialGate(x_out)

        return x_out1


class SPIM(nn.Module):
    def __init__(self, in_channels):
        super(SPIM, self).__init__()

        self.fusion_conv = nn.Sequential(
            nn.Conv2d(in_channels * 3, in_channels, 3, 1, 1),
            nn.BatchNorm2d(in_channels),
            nn.ReLU(inplace=True))

        self.attention = nn.Sequential(
            nn.Conv2d(in_channels, 1, 3, 1, 1),
            nn.BatchNorm2d(1),
            nn.Sigmoid())
        self.GLA = GLA(in_channels)

    def forward(self, maskd, x, maske):  # d边缘 e内部

        _, _, H, W = maske.size()

        x = F.interpolate(x, size=(H, W), mode='bilinear')
        residual = x

        background_att = 1 - maske
        background_x = x * background_att
        self.background_x = background_x

        pred_feature = x * maskd
        self.pred_feature = pred_feature

        input_feature = x * maske
        self.input_feature = input_feature

        fusion_feature = torch.cat([pred_feature, background_x, input_feature], dim=1)
        fusion_feature = self.fusion_conv(fusion_feature)

        attention_map = self.attention(fusion_feature)
        fusion_feature = fusion_feature * attention_map

        out = fusion_feature + residual
        out = self.GLA(out)
        return out


class ChannelAttention(nn.Module):
    def __init__(self, in_channel, reduction=16):
        super(ChannelAttention, self).__init__()
        self.avg_pool = nn.AdaptiveAvgPool2d(1)
        self.fc = nn.Sequential(
            nn.Conv2d(in_channel, in_channel // reduction, kernel_size=1, bias=False),
            nn.ReLU(inplace=True),
            nn.Conv2d(in_channel // reduction, in_channel, kernel_size=1, bias=False)
        )
        self.sigmoid = nn.Sigmoid()

    def forward(self, x):
        return self.sigmoid(self.fc(self.avg_pool(x)))


# Spatial Attention
class SpatialAttention(nn.Module):
    def __init__(self, kernel_size=7):
        super(SpatialAttention, self).__init__()
        self.conv = nn.Conv2d(2, 1, kernel_size, padding=kernel_size // 2, bias=False)
        self.sigmoid = nn.Sigmoid()

    def forward(self, x):
        max_pool = torch.max(x, dim=1, keepdim=True)[0]
        avg_pool = torch.mean(x, dim=1, keepdim=True)
        x_cat = torch.cat([max_pool, avg_pool], dim=1)
        return self.sigmoid(self.conv(x_cat))


class GLA(nn.Module):
    def __init__(self, in_channel):
        super(GLA, self).__init__()
        self.ca = ChannelAttention(in_channel)
        self.sa = SpatialAttention()

    def forward(self, x):
        residual = x
        # ===== Local  =====
        x0, x1 = x.chunk(2, dim=2)
        x0 = x0.chunk(2, dim=3)
        x1 = x1.chunk(2, dim=3)

        x0 = [self.ca(x0[0]) * x0[0], self.ca(x0[1]) * x0[1]]
        x0 = [self.sa(x0[0]) * x0[0], self.sa(x0[1]) * x0[1]]

        x1 = [self.ca(x1[0]) * x1[0], self.ca(x1[1]) * x1[1]]
        x1 = [self.sa(x1[0]) * x1[0], self.sa(x1[1]) * x1[1]]

        x0 = torch.cat(x0, dim=3)
        x1 = torch.cat(x1, dim=3)
        x_local = torch.cat((x0, x1), dim=2)

        # ===== Global  =====
        x_global = self.ca(x) * x
        x_global = self.sa(x_global) * x_global

        # ===== output =====
        out = residual + x_local + x_global
        return out


class CBR(nn.Module):
    def __init__(self, in_channels, out_channels, kernel_size, padding, dilation):
        super(CBR, self).__init__()
        self.block = nn.Sequential(
            nn.Conv2d(in_channels, out_channels, kernel_size=kernel_size, padding=padding, dilation=dilation,
                      bias=False),
            nn.BatchNorm2d(out_channels),
            nn.ReLU(inplace=True)
        )

    def forward(self, x):
        return self.block(x)


class MFEB(nn.Module):
    def __init__(self, in_channels, out_channels):
        super(MFEB, self).__init__()
        self.atrous_block6 = CBR(in_channels, out_channels, kernel_size=3, padding=3, dilation=3)
        self.atrous_block12 = CBR(in_channels, out_channels, kernel_size=3, padding=5, dilation=5)
        self.atrous_block18 = CBR(in_channels, out_channels, kernel_size=3, padding=7, dilation=7)

        self.cbam = CBAM(out_channels)

    def forward(self, x):
        x1 = self.atrous_block6(x)
        x2 = self.atrous_block12(x)
        x3 = self.atrous_block18(x)
        out = x1 + x2 + x3

        return self.cbam(out)


class Polyper(nn.Module):
    def __init__(self):
        super(Polyper, self).__init__()
        in_channels = [64, 128, 320, 512]
        self.backbone = pvt_v2_b2_v2()  # [64, 128, 320, 512]
        path = 'D:/study/pth/pvt_v2_b2.pth'
        save_model = torch.load(path)
        model_dict = self.backbone.state_dict()
        state_dict = {k: v for k, v in save_model.items() if k in model_dict.keys()}
        model_dict.update(state_dict)
        self.backbone.load_state_dict(model_dict)

        self.SPIM1 = SPIM(in_channels=64)
        self.SPIM2 = SPIM(in_channels=64)
        self.SPIM3 = SPIM(in_channels=64)

        self.gla1 = GLA(in_channels[1])  # GLA global and local attention
        self.gla2 = GLA(in_channels[2])
        self.gla3 = GLA(in_channels[3])

        self.mfeb1 = MFEB(128, out_channels=64)  # Multi-scale Feature Extractor block
        self.mfeb2 = MFEB(320, out_channels=64)
        self.mfeb3 = MFEB(512, out_channels=64)
        self.mfeb0 = MFEB(64, 64)
        self.dropout = nn.Dropout(0.1)
        self.down_f1 = nn.Conv2d(in_channels[1], 64, kernel_size=1)
        self.down_f2 = nn.Conv2d(in_channels[2], 64, kernel_size=1)
        self.down_f3 = nn.Conv2d(in_channels[3], 64, kernel_size=1)

        self.align1 = nn.Conv2d(in_channels[3], in_channels[2], kernel_size=1)
        self.align2 = nn.Conv2d(in_channels[2], in_channels[1], kernel_size=1)
        self.align3 = nn.Conv2d(in_channels[1], in_channels[0], kernel_size=1)
        self.out = None
        self.final_conv = nn.Conv2d(in_channels[0], 1, kernel_size=1)  

    def forward(self, inputs):
        inputs = self.backbone(inputs)
        x0 = inputs[0]  # 输出尺寸 [batch_size, 64, H/4, W/4]
        x1 = inputs[1]  # 输出尺寸 [batch_size, 128, H/8, W/8]
        x2 = inputs[2]  # 输出尺寸 [batch_size, 320, H/16, W/16]
        x3 = inputs[3]  # 输出尺寸 [batch_size, 512, H/32, W/32]


        target_size = inputs[0].shape[-2:]  

        f0 = self.mfeb0(x0)
        f1 = F.interpolate(self.mfeb1(x1), size=target_size, mode='bilinear', align_corners=False)
        f2 = F.interpolate(self.mfeb2(x2), size=target_size, mode='bilinear', align_corners=False)
        f3 = F.interpolate(self.mfeb3(x3), size=target_size, mode='bilinear', align_corners=False)

        pred_init = f0 + f1 + f2 + f3
        pred_init = self.final_conv(pred_init)
        mask_d, mask_e = MBEM(pred_init)

        e1 = self.SPIM1(mask_d, f0, mask_e)
        e2 = self.SPIM2(mask_d, f1, mask_e)
        e3 = self.SPIM3(mask_d, f2, mask_e)

        e1 = self.final_conv(e1)
        e2 = self.final_conv(e2)
        e3 = self.final_conv(e3)

        out3 = e3 + pred_init
        out2 = out3 + e2
        out1 = out2 + e1

        out1 = F.interpolate(out1, scale_factor=4, mode='bilinear')
        out2 = F.interpolate(out2, scale_factor=4, mode='bilinear')
        out3 = F.interpolate(out3, scale_factor=4, mode='bilinear')

        return out1, out2, out3
